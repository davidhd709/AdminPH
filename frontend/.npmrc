# ===== Configuración pnpm endurecida (supply-chain) =====

# pnpm 10 NO ejecuta lifecycle scripts de dependencias por defecto.
# Solo los paquetes listados en package.json > pnpm.onlyBuiltDependencies
# pueden correr sus scripts de build. Mantener esa lista al mínimo.

# Lockfile siempre presente y respetado.
lockfile=true

# Falla si el lockfile está desactualizado (evita instalaciones "sorpresa").
# En CI se recomienda `pnpm install --frozen-lockfile`.
prefer-frozen-lockfile=true

# Registry oficial explícito.
registry=https://registry.npmjs.org/

# No elevar dependencias no declaradas (evita phantom dependencies).
# (pnpm ya lo hace por defecto con node_modules estricto; explícito por claridad.)
hoist=false

# Cooldown de versiones: rechaza paquetes publicados hace menos de N minutos.
# Mitiga el ataque de "versión recién comprometida". Desactivado por defecto
# porque bloquearía versiones legítimas muy recientes (ej. Angular nightly).
# Para activarlo en un entorno más estricto, descomentar (10080 = 7 días):
# minimumReleaseAge=10080
