# Plantilla de variables de PRODUCCIÓN. Copiar a `.env.production` en el VPS
# (NUNCA commitear el archivo con valores reales). Generar secrets fuertes:
#   openssl rand -hex 32

NODE_ENV=production
PORT=3000

# Postgres (el host es el nombre del servicio en docker-compose.prod.yml).
POSTGRES_USER=adminph
POSTGRES_PASSWORD=__CAMBIAR__
POSTGRES_DB=adminph_db
DATABASE_URL=postgresql://adminph:__CAMBIAR__@postgres:5432/adminph_db?schema=public

# JWT — rotar antes de salir a producción.
JWT_ACCESS_SECRET=__CAMBIAR_openssl_rand_hex_32__
JWT_REFRESH_SECRET=__CAMBIAR_openssl_rand_hex_32__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS: dominios del frontend separados por coma. NUNCA "*".
CORS_ORIGINS=https://app.adminph.example

# URL del frontend (links de reset de password, etc.).
FRONTEND_URL=https://app.adminph.example

# Imagen a desplegar (la setea el pipeline de deploy).
BACKEND_IMAGE=ghcr.io/davidhd709/adminph/backend:latest
