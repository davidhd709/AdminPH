DATABASE_URL="postgresql://postgres:password123@localhost:5432/adminph?schema=public"
PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET=super-secret-key-for-access-tokens
JWT_REFRESH_SECRET=even-more-secret-key-for-refresh-tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Lista separada por comas. En production es obligatoria (sin "*").
# El nombre legacy CORS_ORIGIN sigue siendo aceptado en dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Throttler — los valores reales están en código (AppModule) por endpoint.
# Estas variables existen como referencia para futura migración a env-based.
THROTTLE_TTL=60
THROTTLE_LIMIT=100
