generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN
  COMPANY_ADMIN
  PROPERTY_ADMIN
  ACCOUNTANT
  SECURITY
  OWNER
  RESIDENT
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

enum UnitStatus {
  OCCUPIED
  VACANT
  RENTED
  MAINTENANCE
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PARTIAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  FAILED_LOGIN
  CHANGE_PASSWORD
  PASSWORD_RESET
  GENERATE
}

enum FeeConceptType {
  ADMINISTRATION
  EXTRAORDINARY
  FINE
  INTEREST
  PARKING
  OTHER
}

enum CalculationType {
  FIXED
  COEFFICIENT
}

enum InterestType {
  DAILY
  MONTHLY
}

model Company {
  id        String        @id @default(uuid())
  name      String
  nit       String?       @unique
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  properties  Property[]
  users       User[]
  auditLogs   AuditLog[]
  feeConcepts   FeeConcept[]
  fees          Fee[]
  payments      Payment[]
  pqrs          Pqr[]
  announcements Announcement[]
  commonAreas   CommonArea[]
  reservations  Reservation[]
  visitors      Visitor[]
  pets          Pet[]
  vehicles      Vehicle[]
  assemblies    Assembly[]
  documents     Document[]
  bankAccounts  BankAccount[]
  acctCategories AccountingCategory[]
  transactions  Transaction[]
  budgets       Budget[]

  @@index([id])
}

model Property {
  id               String         @id @default(uuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  nit              String?        @unique
  address          String
  city             String
  department       String
  phone            String?
  email            String?
  coefficientTotal Decimal        @db.Decimal(18, 8)
  status           PropertyStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  towers        Tower[]
  units         Unit[]
  propertyUsers PropertyUser[]
  fees          Fee[]
  payments      Payment[]
  auditLogs     AuditLog[]
  feeConcepts   FeeConcept[]
  lateFeeConfig LateFeeConfig?
  pqrs          Pqr[]
  announcements Announcement[]
  commonAreas   CommonArea[]
  reservations  Reservation[]
  visitors      Visitor[]
  pets          Pet[]
  vehicles      Vehicle[]
  assemblies    Assembly[]
  documents     Document[]
  bankAccounts  BankAccount[]
  acctCategories AccountingCategory[]
  transactions  Transaction[]
  budgets       Budget[]

  @@index([companyId])
  @@index([id])
}

model LateFeeConfig {
  id           String       @id @default(uuid())
  propertyId   String       @unique
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  companyId    String
  interestRate Decimal      @db.Decimal(5, 2)
  interestType InterestType @default(MONTHLY)
  graceDays    Int          @default(5)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([propertyId])
}

model Tower {
  id          String    @id @default(uuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  units         Unit[]
  announcements Announcement[]

  @@index([propertyId])
}

model Unit {
  id          String     @id @default(uuid())
  towerId     String?
  tower       Tower?     @relation(fields: [towerId], references: [id])
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code        String // e.g. "A-101"
  floor       Int
  number      String
  area        Decimal    @db.Decimal(10, 2)
  coefficient Decimal    @db.Decimal(18, 8)
  status      UnitStatus @default(VACANT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  owners        Owner[]
  residents     Resident[]
  fees          Fee[]
  payments      Payment[]
  auditLogs     AuditLog[]
  pqrs          Pqr[]
  announcements Announcement[]
  reservations  Reservation[]
  visitors      Visitor[]
  pets          Pet[]
  vehicles      Vehicle[]
  attendances   AssemblyAttendance[]
  votes         Vote[]

  @@unique([propertyId, code])
  @@index([propertyId])
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  fullName          String
  document          String    @unique
  phone             String?
  globalRole        UserRole  @default(RESIDENT)
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id])
  propertyUsers       PropertyUser[]
  payments            Payment[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  owners              Owner[]
  residents           Resident[]
  pqrsCreated          Pqr[]              @relation("PqrCreatedBy")
  pqrResponses         PqrResponse[]      @relation("PqrResponseAuthor")
  announcementsCreated Announcement[]     @relation("AnnouncementCreatedBy")
  announcementReads    AnnouncementRead[] @relation("AnnouncementReadBy")
  reservationsMade     Reservation[]        @relation("ReservationRequestedBy")
  reservationsReviewed Reservation[]        @relation("ReservationReviewedBy")
  visitorsRegistered   Visitor[]            @relation("VisitorRegisteredBy")
  assembliesCreated    Assembly[]           @relation("AssemblyCreatedBy")
  attendanceProxies    AssemblyAttendance[] @relation("AttendanceProxy")
  votesCast            Vote[]               @relation("VoteCastBy")
  documentsUploaded    Document[]           @relation("DocumentUploadedBy")
  transactionsCreated  Transaction[]        @relation("TransactionCreatedBy")

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 hex del token enviado por email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 hex del refresh token JWT
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId, revokedAt])
}

model PropertyUser {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  role       UserRole
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, propertyId])
}

model Owner {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  unitId    String
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  isPrimary Boolean   @default(true)
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([unitId])
}

model Resident {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  unitId    String
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([unitId])
}

model FeeConcept {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  type            FeeConceptType  @default(ADMINISTRATION)
  calculationType CalculationType @default(FIXED)
  defaultAmount   Decimal         @db.Decimal(18, 2)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  fees Fee[]

  @@index([companyId])
  @@index([propertyId])
}

model Fee {
  id            String     @id @default(uuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  conceptId     String
  concept       FeeConcept @relation(fields: [conceptId], references: [id])
  amount        Decimal    @db.Decimal(18, 2)
  pendingAmount Decimal    @db.Decimal(18, 2)
  paidAmount    Decimal    @default(0) @db.Decimal(18, 2)
  dueDate       DateTime
  status        FeeStatus  @default(PENDING)
  period        String // e.g. "2026-05"
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  allocations PaymentAllocation[]

  @@unique([unitId, conceptId, period])
  @@index([companyId])
  @@index([propertyId])
  @@index([unitId, status])
}

model Payment {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit          @relation(fields: [unitId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Decimal       @db.Decimal(18, 2)
  receiptUrl      String
  bankReference   String
  status          PaymentStatus @default(PENDING_REVIEW)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  allocations PaymentAllocation[]

  @@unique([propertyId, bankReference])
  @@index([companyId])
  @@index([propertyId])
  @@index([unitId])
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeId           String
  fee             Fee      @relation(fields: [feeId], references: [id])
  amountAllocated Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  @@index([paymentId])
  @@index([feeId])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  companyId  String?
  company    Company?    @relation(fields: [companyId], references: [id])
  propertyId String?
  property   Property?   @relation(fields: [propertyId], references: [id])
  unitId     String?
  unit       Unit?       @relation(fields: [unitId], references: [id])
  entityName String
  entityId   String
  action     AuditAction
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  timestamp  DateTime    @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([propertyId])
  @@index([action, timestamp])
}

// ===================== Fase 7.1 — PQR =====================

enum PqrCategory {
  PETITION // Petición
  COMPLAINT // Queja
  CLAIM // Reclamo
  SUGGESTION // Sugerencia
  OTHER
}

enum PqrStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

model Pqr {
  id           String      @id @default(uuid())
  ticketNumber Int         @unique @default(autoincrement())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         Unit?       @relation(fields: [unitId], references: [id])
  createdById  String
  createdBy    User        @relation("PqrCreatedBy", fields: [createdById], references: [id])
  category     PqrCategory
  subject      String
  description  String
  status       PqrStatus   @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  responses PqrResponse[]

  @@index([companyId])
  @@index([propertyId])
  @@index([status])
}

model PqrResponse {
  id        String   @id @default(uuid())
  pqrId     String
  pqr       Pqr      @relation(fields: [pqrId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("PqrResponseAuthor", fields: [authorId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([pqrId])
}

// ===================== Fase 7.2 — Comunicados =====================

enum AnnouncementScope {
  PROPERTY // toda la copropiedad
  TOWER // una torre
  UNIT // una unidad específica
}

model Announcement {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  towerId     String?
  tower       Tower?            @relation(fields: [towerId], references: [id])
  unitId      String?
  unit        Unit?             @relation(fields: [unitId], references: [id])
  createdById String
  createdBy   User              @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  scope       AnnouncementScope @default(PROPERTY)
  title       String
  body        String
  publishedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  reads AnnouncementRead[]

  @@index([companyId])
  @@index([propertyId])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("AnnouncementReadBy", fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// ===================== Fase 7.3 — Reservas de zonas comunes =====================

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model CommonArea {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String // Salón social, Piscina, BBQ, Gimnasio, Cancha, etc.
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  reservations Reservation[]

  @@index([companyId])
  @@index([propertyId])
}

model Reservation {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  commonAreaId  String
  commonArea    CommonArea        @relation(fields: [commonAreaId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?             @relation(fields: [unitId], references: [id])
  requestedById String
  requestedBy   User              @relation("ReservationRequestedBy", fields: [requestedById], references: [id])
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(PENDING)
  notes         String?
  reviewedById  String?
  reviewedBy    User?             @relation("ReservationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([companyId])
  @@index([propertyId])
  @@index([commonAreaId, startTime])
}

// ===================== Fase 7.4 — Visitantes / Portería =====================

enum VisitorType {
  VISITOR
  DELIVERY
  PROVIDER
  TECHNICIAN
  OTHER
}

model Visitor {
  id             String      @id @default(uuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId         String?
  unit           Unit?       @relation(fields: [unitId], references: [id])
  registeredById String
  registeredBy   User        @relation("VisitorRegisteredBy", fields: [registeredById], references: [id])
  fullName       String
  document       String?
  type           VisitorType @default(VISITOR)
  entryAt        DateTime    @default(now())
  exitAt         DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([companyId])
  @@index([propertyId])
  @@index([propertyId, entryAt])
}

// ===================== Fase 7.5 — Mascotas y Vehículos =====================

enum VehicleType {
  CAR
  MOTORCYCLE
  BICYCLE
  OTHER
}

model Pet {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name       String
  species    String // perro, gato, etc.
  breed      String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([propertyId])
  @@index([unitId])
}

model Vehicle {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  plate       String
  type        VehicleType @default(CAR)
  brand       String?
  color       String?
  parkingSpot String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@unique([propertyId, plate])
  @@index([propertyId])
  @@index([unitId])
}

// ===================== Fase 7.6/7.7 — Asambleas y Votaciones =====================

enum AssemblyType {
  ORDINARY
  EXTRAORDINARY
}

enum AssemblyStatus {
  SCHEDULED
  IN_PROGRESS
  CLOSED
}

enum VotingType {
  SIMPLE // mayoría por número de votos
  COEFFICIENT // mayoría por coeficiente de copropiedad
}

enum VotingStatus {
  OPEN
  CLOSED
}

enum VoteChoice {
  YES
  NO
  ABSTAIN
  BLANK
}

model Assembly {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User           @relation("AssemblyCreatedBy", fields: [createdById], references: [id])
  title         String
  type          AssemblyType   @default(ORDINARY)
  agenda        String?
  scheduledAt   DateTime
  quorumPercent Decimal?       @db.Decimal(5, 2)
  status        AssemblyStatus @default(SCHEDULED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  attendances AssemblyAttendance[]
  votings     Voting[]

  @@index([companyId])
  @@index([propertyId])
}

model AssemblyAttendance {
  id           String   @id @default(uuid())
  assemblyId   String
  assembly     Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit     @relation(fields: [unitId], references: [id])
  coefficient  Decimal  @db.Decimal(18, 8) // snapshot del coeficiente al registrar
  present       Boolean  @default(true)
  proxyUserId  String? // poder/representación
  proxyUser    User?    @relation("AttendanceProxy", fields: [proxyUserId], references: [id])
  registeredAt DateTime @default(now())

  @@unique([assemblyId, unitId])
  @@index([assemblyId])
}

model Voting {
  id         String       @id @default(uuid())
  assemblyId String
  assembly   Assembly     @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  question   String
  type       VotingType   @default(COEFFICIENT)
  status     VotingStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  closedAt   DateTime?

  votes Vote[]

  @@index([assemblyId])
}

model Vote {
  id          String     @id @default(uuid())
  votingId    String
  voting      Voting     @relation(fields: [votingId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit       @relation(fields: [unitId], references: [id])
  castById    String
  castBy      User       @relation("VoteCastBy", fields: [castById], references: [id])
  choice      VoteChoice
  coefficient Decimal    @db.Decimal(18, 8) // snapshot al votar
  createdAt   DateTime   @default(now())

  @@unique([votingId, unitId])
  @@index([votingId])
}

// ===================== Fase 7.8 — Actas y Documentos =====================

enum DocumentType {
  REGULATION // reglamento de propiedad horizontal
  MINUTES // acta
  CONTRACT
  FINANCIAL_STATEMENT
  BUDGET
  POLICY // póliza
  CERTIFICATE
  COMMUNICATION
  OTHER
}

model Document {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User         @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  type         DocumentType @default(OTHER)
  title        String
  description  String?
  fileUrl      String // path/URL en el storage (R2/MinIO — Fase 9)
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([companyId])
  @@index([propertyId])
  @@index([propertyId, type])
}

// ===================== Fase 7.9 — Contabilidad administrativa =====================

enum TransactionType {
  INCOME
  EXPENSE
}

model BankAccount {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  bank          String
  accountNumber String
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  transactions Transaction[]

  @@index([propertyId])
}

model AccountingCategory {
  id         String          @id @default(uuid())
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  type       TransactionType
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  transactions Transaction[]
  budgetItems  BudgetItem[]

  @@index([propertyId, type])
}

model Transaction {
  id            String              @id @default(uuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bankAccountId String?
  bankAccount   BankAccount?        @relation(fields: [bankAccountId], references: [id])
  categoryId    String?
  category      AccountingCategory? @relation(fields: [categoryId], references: [id])
  createdById   String
  createdBy     User                @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  type          TransactionType
  amount        Decimal             @db.Decimal(18, 2)
  description   String
  date          DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([companyId])
  @@index([propertyId])
  @@index([propertyId, date])
}

model Budget {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  items BudgetItem[]

  @@unique([propertyId, year])
  @@index([propertyId])
}

model BudgetItem {
  id            String             @id @default(uuid())
  budgetId      String
  budget        Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId    String
  category      AccountingCategory @relation(fields: [categoryId], references: [id])
  plannedAmount Decimal            @db.Decimal(18, 2)

  @@unique([budgetId, categoryId])
  @@index([budgetId])
}
